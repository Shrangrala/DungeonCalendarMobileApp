{
  "expo": {
    "name": "Dungeon Calendar",
    "slug": "dungeon-calendar",
    "scheme": "dungeoncalendar",
    "version": "1.0.24",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "dark",
    "description": "Dungeon Calendar helps tabletop RPG groups schedule sessions, manage campaigns, track player availability, invite players, and organize adventures.",
    "android": {
      "package": "com.anonymous.dungeoncalendar",
      "versionCode": 24,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "dungeoncalendar.com",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "dungeoncalendar.com",
              "pathPrefix": "/campaign"
            },
            {
              "scheme": "https",
              "host": "dungeoncalendar.com",
              "pathPrefix": "/results"
            },
            {
              "scheme": "https",
              "host": "dungeoncalendar.com",
              "pathPrefix": "/calendar"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-notifications",
      "expo-local-authentication",
      "expo-secure-store"
    ],
    "platforms": [
      "android",
      "web"
    ],
    "extra": {
      "eas": {
        "projectId": "979ae98a-0eb6-421c-830d-6feceb064b52"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/979ae98a-0eb6-421c-830d-6feceb064b52"
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.dungeoncalendar"
    }
  }
}
