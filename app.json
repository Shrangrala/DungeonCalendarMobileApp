      "package": "com.anonymous.dungeoncalendar",
      "versionCode": 24,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "INTERNET",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-notifications"
    ],
    "platforms": [
      "android",
      "web"
    ],
    "extra": {
      "eas": {
        "projectId": "979ae98a-0eb6-421c-830d-6feceb064b52"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
